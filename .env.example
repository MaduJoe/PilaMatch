# ============================================================
# PilaMatch - Environment Variables
# ============================================================
# cp .env.example .env 후 값을 수정하세요.
# 필수(*) 항목은 반드시 설정해야 합니다.
# ============================================================

# ----------------------------------------------------------
# Docker Compose (PostgreSQL container)
# ----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me                          # * 필수
POSTGRES_DB=pilamatch

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
APP_NAME=PilaMatch API
APP_VERSION=1.0.0
APP_ENV=development                                  # development | production
DEBUG=true                                           # true: Swagger UI 활성화
API_V1_PREFIX=/api/v1
WORKERS=4                                            # 프로덕션 uvicorn 워커 수

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------
# docker-compose 사용 시 자동 구성됩니다.
# 로컬 개발 시 아래 값을 직접 설정하세요.
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/pilamatch
DATABASE_URL_SYNC=postgresql://postgres:change-me@localhost:5432/pilamatch

# DB Connection Pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800                                 # 30분 (초)

# ----------------------------------------------------------
# JWT Authentication
# ----------------------------------------------------------
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32  # * 필수 (openssl rand -hex 32)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------
# Redis
# ----------------------------------------------------------
# JWT 블랙리스트, OTP 저장, 세션 캐시 용도
REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------
# TossPayments (SDK V2 - 카드/간편결제 통합 결제창)
# ----------------------------------------------------------
# 아래는 토스 공식 테스트 키입니다. 프로덕션에서는 라이브 키로 교체하세요.
# 값이 없거나 "xxxx"이면 Mock 모드로 동작합니다.
# Client Key: 프론트엔드 SDK 초기화용 (결제창 호출 시 사용)
# Secret Key: 백엔드 결제 승인 API 인증용 (Base64 인코딩 → Basic Auth)
# TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
TOSS_CLIENT_KEY=test_ck_vZnjEJeQVxaKZba2kWBqrPmOoBN0
# TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6
TOSS_SECRET_KEY=test_sk_KNbdOvk5rk50NQaeAyew3n07xlzm
TOSS_WEBHOOK_SECRET=

# ----------------------------------------------------------
# SMS (CoolSMS)
# ----------------------------------------------------------
SMS_PROVIDER=mock                                    # mock | coolsms
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_NUMBER=

# ----------------------------------------------------------
# Business Verification (국세청 NTS)
# ----------------------------------------------------------
NTS_SERVICE_KEY=

# ----------------------------------------------------------
# Banking (무통장입금)
# ----------------------------------------------------------
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=
BANK_NAME=

# ----------------------------------------------------------
# Cron / Scheduler
# ----------------------------------------------------------
CRON_SECRET=

# ----------------------------------------------------------
# Email
# ----------------------------------------------------------
EMAIL_PROVIDER=mock                                  # mock | smtp | sendgrid
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ----------------------------------------------------------
# File Upload
# ----------------------------------------------------------
STORAGE_BACKEND=local                                # local | s3
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
UPLOAD_MAX_SIZE_MB=10

# ----------------------------------------------------------
# Push Notification
# ----------------------------------------------------------
FCM_SERVER_KEY=

# ----------------------------------------------------------
# Monitoring
# ----------------------------------------------------------
SENTRY_DSN=

# ----------------------------------------------------------
# CORS
# ----------------------------------------------------------
# 쉼표 구분 없이 JSON 배열 형태로 설정됩니다 (config.py 기본값 참조).
# docker-compose 환경에서는 기본값이 적용되므로 별도 설정 불필요.
# ALLOWED_ORIGINS=["http://localhost:8501","http://localhost:3000"]

# ----------------------------------------------------------
# Frontend / External URLs
# ----------------------------------------------------------
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8501
BACKEND_PUBLIC_URL=http://localhost:8000              # 브라우저에서 접근 가능한 백엔드 URL
KAKAO_MAP_KEY=037071d1b4c45b32f1258e9f05fc11be        # 카카오맵 JavaScript API 키
KAKAO_REST_API_KEY=f562a71b13dcad881fee2b157d93121c                                   # 카카오 REST API 키 (주소 검색 백엔드 프록시용)
